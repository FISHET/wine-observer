# Copy to .env.local (git-ignored) and fill in.
#
# CT_USER is your CellarTracker *username*, not the email address you log in
# with. It is the handle shown in your profile URL:
#   https://www.cellartracker.com/list.asp?Table=List&User=<this bit>
#
# Special characters are safe and need no quoting or escaping: a '#' only
# starts a comment at the start of a line or after a space. See src/env.ts.
CT_USER=
CT_PASSWORD=
